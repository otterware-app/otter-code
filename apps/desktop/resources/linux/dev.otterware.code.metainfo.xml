  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Otter Code</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="app.otterware">
    <name>Otterware</name>
  </developer>
  <description>
    <p>
      Otter Code is an open-source desktop app for coding agents. Work with your
