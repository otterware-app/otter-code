# Public Otter Accounts and Connect defaults are built into Otter Code.
# Override these together only for a separately registered staging deployment.
# Server-side credentials do not belong in this file.
T3CODE_ACCOUNTS_URL=https://accounts.otterware.app/v1/auth
T3CODE_ACCOUNTS_CLI_CLIENT_ID=otter-code-cli
T3CODE_RELAY_URL=https://relay.code.otterware.app
T3CODE_HOSTED_APP_URL=https://code.otterware.app

# Optional public, ingest-only mobile tracing configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=otter-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
