      your projects.
    </p>
    <p>
      Connect from desktop, web, or mobile to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">otter-code.desktop</launchable>
  <icon type="stock">otter-code</icon>
  <provides>
    <binary>otter-code</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://code.otterware.app</url>
  <url type="bugtracker">https://github.com/otterware-app/otter-code/issues</url>
  <url type="vcs-browser">https://github.com/otterware-app/otter-code</url>
