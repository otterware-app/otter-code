{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "otter-code-web",
  "account_id": "c2256e4c101903cb1e0aa34527ebcb81",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "code.otterware.app", "custom_domain": true },
    { "pattern": "latest.code.otterware.app", "custom_domain": true },
    { "pattern": "nightly.code.otterware.app", "custom_domain": true },
    { "pattern": "code.otterware.dev", "custom_domain": true },
    { "pattern": "latest.code.otterware.dev", "custom_domain": true },
    { "pattern": "nightly.code.otterware.dev", "custom_domain": true }
  ]
}
