{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Runs in Node (Electron's main process) and in a browser Web Worker: only
    // what both have. Anything else comes through the Platform (src/platform.ts).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src"],
  // Node-only test helpers; checked by their own tsconfig.
  "exclude": ["src/protocols/test", "src/providers/imap/test", "src/services/test"]
}
